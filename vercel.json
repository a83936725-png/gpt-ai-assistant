{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*": {
      "maxDuration": 60,
      "includeFiles": "{knowledge,web,mom-app}/**"
    }
  },
  "crons": [
    {
      "path": "/instagram/cron",
      "schedule": "0 13 * * *"
    }
  ]
}
